{
  "description": "app-factory: in an app-factory project, replaces stored API key values and known key patterns in Bash/Read/Grep output with their names; caps large Bash outputs of its own run's agents (subagents during an active run only); native macOS banner + chime when Claude needs input or finishes, only while the editor isn't frontmost",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/firewall.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/attention.sh\"", "async": true }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/attention.sh\"", "async": true }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/attention.sh\"", "async": true }
        ]
      }
    ]
  }
}
