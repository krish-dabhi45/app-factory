<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_115sdp">

    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/flNativeAds"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.gms.ads.nativead.NativeAdView
            android:id="@+id/ad_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center">

            <LinearLayout
                android:id="@+id/admob_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="@dimen/_6sdp"
                android:weightSum="10">

                <!-- LEFT : 40% (Ad badge upar, gap, pachhi image) -->
                <!--<LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ad_attribution"
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:background="#FF6F5F"
                        android:fontFamily="@font/poppinsmedium"
                        android:gravity="center"
                        android:text="Ad"
                        android:textColor="#131622"
                        android:textSize="@dimen/_8sdp" />

                    <ImageView
                        android:id="@+id/ad_icon"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop" />
                </LinearLayout>-->

                <!-- LEFT : 45% (Ad badge upar, gap, pachhi MediaView) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="5"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ad_attribution"
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:background="#FF6F5F"
                        android:fontFamily="@font/poppinsmedium"
                        android:gravity="center"
                        android:text="Ad"
                        android:textColor="#131622"
                        android:textSize="@dimen/_8sdp" />

                    <com.google.android.gms.ads.nativead.MediaView
                        android:id="@+id/ad_media"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- RIGHT : 60% (header top, stars, body center, button bottom) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/_8sdp"
                    android:layout_weight="5"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ad_headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppinsbold"
                        android:lines="1"
                        android:textColor="#FF6F5F"
                        android:textSize="@dimen/_12sdp"
                        android:textStyle="bold" />

                    <!-- Advertiser + Rating stars: header ni just niche -->
                    <LinearLayout
                        android:id="@+id/star_lay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/ad_advertiser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/_4sdp"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppinsbold"
                            android:lines="1"
                            android:textColor="#E0DFDF"
                            android:textSize="@dimen/_8sdp" />

                        <RatingBar
                            android:id="@+id/ad_stars"
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:isIndicator="true"
                            android:numStars="5"
                            android:stepSize="0.5"
                            android:theme="@style/RatingBar" />
                    </LinearLayout>

                    <!-- Body: bachelu space le, text vachche center ma -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/ad_body"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppinsregular"
                        android:gravity="center_vertical"
                        android:maxLines="3"
                        android:textColor="#ffffff"
                        android:textSize="@dimen/_9sdp" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/btn_card"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_32sdp"
                        app:cardCornerRadius="@dimen/_10sdp">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/ad_call_to_action"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/poppinsmedium"
                            android:gravity="center"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:text=""
                            android:textColor="#ffffff"
                            android:textSize="@dimen/_12sdp" />
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </LinearLayout>

        </com.google.android.gms.ads.nativead.NativeAdView>

    </FrameLayout>

</com.google.android.gms.ads.nativead.NativeAdView>